{
  "name": "gimbal",
  "version": "0.1.0",
  "description": "Deterministic-first end-to-end testing for modern web applications",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/dakshyadav1810/gimbal.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dakshyadav1810/gimbal/issues"
  },
  "homepage": "https://github.com/dakshyadav1810/gimbal#readme",
  "keywords": ["testing", "playwright", "e2e", "mcp", "test-automation"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md"],
  "bin": {
    "gimbal": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@gimbal/core": "workspace:*",
    "@gimbal/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.2.0",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
